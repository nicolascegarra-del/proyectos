# Entorno: development | staging | production.
# En production/staging el backend ABORTA el arranque si SECRET_KEY/FERNET_KEY/
# SUPERADMIN_PASSWORD siguen siendo los valores por defecto (fail-fast de seguridad).
APP_ENV=development

# PostgreSQL nativo (fuera de Docker). Crea el rol/BD con la MISMA contraseña.
#  - Backend nativo (uvicorn en el host):   @localhost:5432
#  - Backend en Docker (docker-compose):    @host.docker.internal:5432  (lo inyecta el compose)
#  - Producción (Coolify):                  define DATABASE_URL en env vars, NO aquí
DATABASE_URL=postgresql+asyncpg://klyp:CAMBIA_ESTA_PASSWORD@localhost:5432/klyp

# Genera uno nuevo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-very-long-secret-key-please-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Clave de cifrado para credenciales SMTP. OBLIGATORIA en producción.
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
FRONTEND_URL=http://localhost:5173
APP_NAME=Klyp
SUPERADMIN_EMAIL=admin@klyp.app
SUPERADMIN_PASSWORD=changeme
